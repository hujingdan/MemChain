# MemChain 环境变量配置示例
#
# 使用方法：
# 1. 复制此文件为 .env
# 2. 填写实际的配置值
# 3. 确保 .env 文件不会被提交到Git仓库

# ==================== 火山方舟AI配置 ====================
# 获取API Key：
# 1. 访问 https://console.volcengine.com/
# 2. 注册/登录火山引擎账号
# 3. 开通机器学习平台（火山方舟）服务
# 4. 创建API Key

# 火山方舟API密钥（必填）
VOLCENGINE_API_KEY=b384df75-8628-4df6-90d3-d650819ff15a

# 火山方舟API端点（可选，默认使用北京区域）
VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 默认使用的AI模型（可选，默认使用deepseek-v3）
DEFAULT_MODEL=deepseek-v3-250324

# AI调用超时时间（秒，可选，默认30）
AI_TIMEOUT=30

# API调用最大重试次数（可选，默认3）
AI_MAX_RETRIES=3

# ==================== 数据库配置 ====================
# 数据库连接URL（可选，默认使用SQLite）
# SQLite示例：
DATABASE_URL=sqlite:///./data/memchain.db
# PostgreSQL示例：
# DATABASE_URL=postgresql://user:password@localhost:5432/memchain

# ==================== 存储配置 ====================
# 存储类型（local或s3，默认local）
STORAGE_TYPE=local

# 本地存储路径（当STORAGE_TYPE=local时使用）
LOCAL_STORAGE_PATH=./data/materials

# 临时文件存储路径
TEMP_STORAGE_PATH=./data/tmp

# AWS S3配置（当STORAGE_TYPE=s3时使用）
# AWS_ACCESS_KEY=your-aws-access-key
# AWS_SECRET_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# S3_BASE_PATH=uploads/

# ==================== 上传配置 ====================
# 最大上传大小（字节，默认10GB）
MAX_UPLOAD_SIZE=10737418240

# 分片上传大小（字节，默认5MB）
UPLOAD_CHUNK_SIZE=5242880

# ==================== 应用配置 ====================
# 应用运行端口（可选，默认8000）
PORT=8000

# 调试模式（可选，默认False）
DEBUG=False

# 日志级别（可选，默认INFO）
LOG_LEVEL=INFO

# ==================== 安全配置 ====================
# JWT密钥（用于身份验证，生产环境必须修改）
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# 会话密钥（用于会话管理，生产环境必须修改）
SECRET_KEY=your-secret-key-change-in-production
